# Application
APP_ENV=development
PROJECT_ROOT=.

# Paths
DATA_PROCESSED_PATH=data/processed/student_performance.csv
MODEL_PATH=models/random_forest.pkl
VECTOR_DB_PATH=vector_db_js
LESSONS_PATH=data/lessons_js

# LLM provider: ollama | gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
# Optional backup when primary fails (quota, outage, etc.)
LLM_PROVIDER_FALLBACK=groq
LLM_TEMPERATURE=0.2

# Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic / Claude API — https://console.anthropic.com/ (separate from Claude Pro subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama (only if LLM_PROVIDER=ollama) — heavy on CPU/RAM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Groq (optional) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (optional) — only if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Streamlit PoC login (not production auth)
UI_COACH_PASSWORD=coach123
UI_LEARNER_PASSWORD=student123
# Accounts: coach / student1 … student24

# Memory
SHORT_TERM_MEMORY_TURNS=5

# RAG
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ML
AT_RISK_THRESHOLD=10.0
RANDOM_SEED=42
